# Copy to .env and adjust. Per-environment overrides go in envs/<name>.env.

GO_VERSION=1.26
NUCLEI_VERSION=v3.11.1

# Target list inside ./targets (example.txt is a placeholder)
TARGET_FILE=example.txt
# Report file written to ./reports
REPORT_FILE=results.jsonl

SEVERITY=low,medium,high,critical
RATE_LIMIT=50
CONCURRENCY=25

MEM_LIMIT=2g
CPU_LIMIT=2
